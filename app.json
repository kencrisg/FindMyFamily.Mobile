{
  "expo": {
    "name": "FindMyFamily.Mobile",
    "slug": "FindMyFamily.Mobile",
    "scheme": "findmyfamily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FindMyFamily usa tu ubicación para compartirla con tu círculo familiar únicamente cuando un familiar la solicita.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FindMyFamily necesita acceso en segundo plano para responder a una solicitud de ubicación de tu familia sin que tengas que abrir la app.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.kencrisgdev.findmyfamily"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "package": "com.kencrisgdev.findmyfamily"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FindMyFamily necesita acceso en segundo plano para responder a una solicitud de ubicación de tu familia sin que tengas que abrir la app.",
          "locationWhenInUsePermission": "FindMyFamily usa tu ubicación para compartirla con tu círculo familiar únicamente cuando un familiar la solicita.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ]
  }
}
