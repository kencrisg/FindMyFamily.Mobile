# ==============================================================================
# FINDMYFAMILY MOBILE - VARIABLES DE ENTORNO (EXPO SDK)
# ==============================================================================
# En Expo, las variables accesibles en el cliente deben comenzar con EXPO_PUBLIC_
# 
# Guía de URL según tu entorno de ejecución:
# - Simulador iOS:               http://localhost:5210
# - Emulador Android:            http://10.0.2.2:5210
# - Dispositivo físico (WiFi):   http://<IP_DE_TU_COMPUTADORA>:5210 (ej: http://192.168.1.50:5210)
#   Para un dispositivo físico, arranca la API con el perfil que escucha en toda la red:
#     dotnet run --project FindMyFamily.Api --launch-profile lan
#   El perfil por defecto solo escucha en localhost y el teléfono no puede alcanzarlo.
# - Servidor de Producción:      https://api.tudominio.com
# ==============================================================================

EXPO_PUBLIC_API_URL=http://localhost:5210
